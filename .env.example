# --- Required: the tutor brain. Server-side only, never sent to the browser. ---
OPENROUTER_API_KEY=sk-or-v1-...

# --- Supabase: accounts, sync, profile pictures ---
# OPTIONAL. These already ship as built-in defaults in lib/config.ts, so
# sign-in works with nothing set here. Both are NEXT_PUBLIC_ and therefore
# public by design; row-level security is what protects the data. Set these
# only to point a fork at a different Supabase project.
NEXT_PUBLIC_SUPABASE_URL=https://fhitmtbhaqqqjfdjennl.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# --- Voice: natural speech instead of the browser's robotic default ---
# Without it the app falls back to the device's built-in voice, which still
# works but sounds synthetic. The free tier is ~10k characters per month.
ELEVENLABS_API_KEY=sk_...
# Leave unset unless you want a specific voice. Free accounts get 402
# paid_plan_required on "library" voices (Rachel, Aria) — these are default
# voices, verified working on a free key:
#   EXAVITQu4vr4xnSDxMaL  Sarah   (the default here)
#   FGY2WhTYpPnrIDTdsKH5  Laura
#   JBFqnCBsd6RMkjVDRZzb  George
# ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
# ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# --- Optional ---
# Your deployment's real URL — used for OAuth redirects and OpenRouter
# attribution. This is NOT guessable from the app's name: it comes from your
# Vercel PROJECT name. Copy it from the Vercel dashboard.
NEXT_PUBLIC_SITE_URL=https://mintai-three.vercel.app

# --- Which models answer, and how fast ---
# By default the app tries three fast PAID models first and only falls back to
# the free tier if they fail. That is the whole difference between a reply in
# about a second and one in twenty: free models are queued behind everyone
# else's traffic and mostly burn their budget on hidden reasoning.
#
# Paid needs credit on the OpenRouter account. Without it every paid model
# returns 402, the chain falls through to the free models automatically, and
# the app works exactly as it did before — just slowly. Nothing breaks.
#
# Cost is small: roughly $0.0005 a turn at the top of the chain, so a hundred
# questions is about five cents.
#
# Set these to pin your own chain. Comma-separated, tried in order.
# To go back to free-only, list only :free models here.
# OPENROUTER_TEXT_MODELS=google/gemini-3.1-flash-lite,openai/gpt-5-mini
# OPENROUTER_VISION_MODELS=google/gemini-3.1-flash-lite,openai/gpt-5-mini

# --- Using a provider other than OpenRouter ---
# Any OpenAI-compatible chat-completions endpoint works. NVIDIA NIM is the
# other one this is known to run against:
#
#   NVIDIA_API_KEY=nvapi-...
#   OPENROUTER_BASE_URL=https://integrate.api.nvidia.com/v1
#   OPENROUTER_TEXT_MODELS=<a model NVIDIA hosts>
#   OPENROUTER_VISION_MODELS=<a VLM NVIDIA hosts>
#
# The model chains are NOT optional here. The built-in defaults are OpenRouter
# IDs and mean nothing on another provider, so the app refuses to start a
# request rather than 404 its way down the chain and blame "busy models".
#
# Scan needs a model that accepts images. A text-only model will serve Chat and
# Voice perfectly well and fail every photo. List what the provider actually
# hosts:
#   curl -s https://integrate.api.nvidia.com/v1/models #     -H "Authorization: Bearer $NVIDIA_API_KEY" | grep -o '"id":"[^"]*"'
#
# OpenRouter-only parameters (the `reasoning` object, the attribution headers)
# are dropped automatically when the base URL is not OpenRouter — NVIDIA
# rejects `reasoning` outright rather than ignoring it.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Real YouTube results with thumbnails. Without it, recommendations open as
# YouTube searches instead, which works fine and costs nothing.
# YOUTUBE_API_KEY=
